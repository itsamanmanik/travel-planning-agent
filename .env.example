# Copy this file to ".env" and fill in your free Groq key.
#   1. Go to https://console.groq.com   (sign up free, no credit card)
#   2. Create an API key
#   3. Paste it below

# GROQ_API_KEY=your_free_groq_key_here

# Optional settings (safe defaults are used if you leave these out):
# MODEL_NAME=openai/gpt-oss-120b
# CHROMA_DIR=./data/chroma
# MAX_HISTORY_MESSAGES=10
